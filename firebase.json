{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/beta",
        "run": {
          "serviceId": "spotify-dashboard-beta",
          "region": "europe-west2"
        }
      },
      {
        "source": "/beta/**",
        "run": {
          "serviceId": "spotify-dashboard-beta",
          "region": "europe-west2"
        }
      },
      {
        "source": "**",
        "run": {
          "serviceId": "spotify-dashboard-service",
          "region": "europe-west2"
        }
      }
    ]
  }
}
